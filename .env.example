# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://webflowai:webflowai@localhost:5432/webflowai?schema=public"

# AI — WEBFLOWAI_MODEL must match the Azure deployment name, not only the
# underlying model name.
AZURE_OPENAI_API_KEY=""
AZURE_RESOURCE_NAME=""
WEBFLOWAI_MODEL="your-deployment-name"

# LangSmith tracing (server-only)
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="webflowai"

# E2B remote runtime (server-only)
E2B_API_KEY=""

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
